%% Current implemented HMS architecture, 2026-10-17.
%% Solid arrows represent existing code paths, not a claim that each process is running.
%% Explicit API mode is connected; demo remains independent. Original PATCH remains notes/counts only.
flowchart TB
    subgraph FRONTEND["Existing frontend - React / TypeScript / Vite"]
        UI["Pages and components<br/>Reservations, calendars, room configuration"]
        STATE["ReservationDemoProvider<br/>Business state in browser memory<br/>Resets on reload"]
        RULES["Frontend domain helpers<br/>Pricing, validation, lifecycle and time"]
        FIXTURES["Demo reservations and sample configuration"]
        UI <--> STATE
        UI --> RULES
        STATE --> RULES
        FIXTURES --> STATE
    end

    GAP["Demo is the default and remains independent<br/>Explicit API mode never falls back to fixtures"]

    subgraph API_FRONTEND["Configured API-backed React mode"]
        API_UI["Original rich pages, calendar and pane<br/>Awaited reservation, room/configuration and catalog commands<br/>Unsupported writes unavailable"]
        API_STATE["Separate ApiProvider<br/>Canonical UUIDs, versions, captured minor-unit prices<br/>Loading/error states; drafts retained on failed save"]
        API_CLIENT["Typed API clients<br/>Paginated bootstrap and awaited POST/PATCH<br/>Expected version and request-key retry"]
        API_UI --> API_STATE
        DOC_UI["Billing Documents in reservation detail<br/>Explicit captured draft/review/finalize<br/>Durable original-key retries<br/>Separate Operational Billing Statement print"]
        API_UI --> DOC_UI
        DOC_UI --> API_CLIENT
        API_STATE --> API_CLIENT
    end

    subgraph BACKEND["Isolated local backend - own Python virtual environment"]
        API["FastAPI via Uvicorn<br/>127.0.0.1:8001 when started"]
        LIVE["GET /api/v1/live<br/>Process liveness - no database access"]
        HEALTH["GET /api/v1/health<br/>Database readiness - SELECT 1<br/>200 healthy / 503 unavailable"]
        CONFIG["Pydantic settings and target guard<br/>Ignored local .env<br/>Only owned loopback database targets allowed"]
        ENGINE["SQLAlchemy + psycopg<br/>PostgreSQL connections in UTC"]
        ROUTES["Guest and reference APIs<br/>Reservation POST / list / detail<br/>Original PATCH: notes/counts only<br/>Explicit guest, stay, lifecycle, readiness and billing commands<br/>Versioned configuration/catalog endpoints"]
        COMMANDS["Reservations service<br/>Single or multi-room direct/non-direct bookings<br/>Captured contractual accommodation, exact commission and pending expectations<br/>Allocation-specific hourly/nightly stays and derived parent range<br/>Independent/strict bulk lifecycle<br/>Version/row locks + request-key advisory lock<br/>Sorted room locks and PostgreSQL overlap exclusion<br/>One transaction: allocations, pricing, audit, receipt"]
        CONTEXT["Server-selected company<br/>Actor: local-development<br/>Business routes restricted to development environment"]
        subgraph MODEL["SQLAlchemy table definitions - schema only"]
            CORE["Core<br/>Companies and hotel time defaults<br/>Operational audit, mutation receipts"]
            RES["Reservations boundary<br/>Guests, rooms, room types, durations, rates,<br/>booking sources, reservations, allocations"]
            BILL["Billing boundary<br/>Append-only operational pricing revisions<br/>Captured purchases and distinct extra charges<br/>Signed adjustments, manual discounts and configured presets<br/>Separate captured final unit prices before reductions<br/>Immutable finalized operational documents and transactional counters<br/>Append-only owned booking-financial captures and reviewed corrections<br/>B7 hotel/channel collections and linked refunds/full reversals<br/>Separate reviewed guest accommodation obligation and component residuals<br/>B7.1 append-only payment allocations/releases and unapplied funds<br/>Atomic ordered initial multi-payment creation<br/>No channel payouts, statutory receipts, accounting journal or posting"]
        end
        CATALOG["Configuration boundary<br/>Owned categories/products and versioned discount/final-price definitions<br/>Stable booking sources and commercial agreement revisions<br/>Inclusive effective dates, immutable published rules and exact configured units<br/>Protected extras, inclusions and virtual breakfast view<br/>Owned defaults and meal/beverage eligibility<br/>Captured allocation entitlements/selections - zero breakfast charge<br/>No stock movement or channel financial ledger"]
        CATALOG --> ALEMBIC
        ROUTES --> CATALOG
        CATALOG --> ENGINE
        DOCS["Backend-only operational billing documents<br/>Fixed draft capture to immutable finalization<br/>Source-version check, company numbering, audit and durable replay<br/>PostgreSQL UPDATE/DELETE guards<br/>No invoice UI, tax engine, payments or accounting"]
        ROUTES --> DOCS
        DOCS --> ENGINE
        DOCS --> ALEMBIC
        ALEMBIC["Alembic<br/>Twenty-five additive schema migrations<br/>Current head: c93da8e4f598<br/>Ownership, overlap, shared or independent stays, retained allocation history, protected catalog, immutable documents and financial transactions"]
        SEED["Explicit development seed command<br/>Transactional, repeatable reference inserts<br/>Does not overwrite existing values"]
        TESTS["Opt-in PostgreSQL and HTTP tests<br/>Concurrency, rollback, server pricing and durable replay<br/>Real API restart verification in hms_test"]
        API --> LIVE
        API --> HEALTH
        API --> CONFIG
        HEALTH --> ENGINE
        API --> ROUTES
        ROUTES --> COMMANDS
        ROUTES --> CONTEXT
        COMMANDS --> ENGINE
        CONFIG --> ENGINE
        CORE --> ALEMBIC
        RES --> ALEMBIC
        BILL --> ALEMBIC
        CONFIG --> ALEMBIC
        SEED --> ENGINE
        TESTS --> ENGINE
    end

    subgraph DOCKER["Own Docker Compose project: hms-local-foundation"]
        PG["PostgreSQL 17.6<br/>Host 127.0.0.1:55432 → container 5432"]
        DEV[("hms_dev<br/>23 tables in hms schema<br/>Minimal explicit references + existing local records<br/>User business data preserved")]
        TESTDB[("hms_test<br/>Separate integration-test database<br/>Same migration history")]
        VOLUME[("Own persistent Docker volume<br/>hms-local-foundation_hms_pgdata")]
        PG --> DEV
        PG --> TESTDB
        PG --> VOLUME
    end

    ENGINE --> PG
    API_CLIENT --> API
    ALEMBIC --> PG

    REHEARSAL["Explicit recovery rehearsal<br/>New isolated PostgreSQL cluster on loopback 55433<br/>hms_rehearsal to fresh hms_restore<br/>Migrations, seed replay, dump/restore and canonical/hash comparisons verified<br/>Owned containers/volumes retained stopped"]
    REHEARSAL --> ALEMBIC

    EXCLUDED["Outside this architecture<br/>ZKBioTime: no shared Python, database or storage<br/>Supabase, native accounting and Odoo: not implemented"]

    classDef note fill:#fff7dd,stroke:#a87914,color:#332700;
    class GAP,EXCLUDED note;
