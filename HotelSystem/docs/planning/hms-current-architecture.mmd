%% Current implemented HMS architecture, 2026-10-13.
%% Solid arrows represent existing code paths, not a claim that each process is running.
%% Explicit API mode is connected; demo remains independent. Original PATCH remains notes/counts only.
flowchart TB
    subgraph FRONTEND["Existing frontend - React / TypeScript / Vite"]
        UI["Pages and components<br/>Reservations, calendars, room configuration"]
        STATE["ReservationDemoProvider<br/>Business state in browser memory<br/>Resets on reload"]
        RULES["Frontend domain helpers<br/>Pricing, validation, lifecycle and time"]
        FIXTURES["Demo reservations and sample configuration"]
        UI <--> STATE
        UI --> RULES
        STATE --> RULES
        FIXTURES --> STATE
    end

    GAP["Demo is the default and remains independent<br/>Explicit API mode never falls back to fixtures"]

    subgraph API_FRONTEND["Configured API-backed React mode"]
        API_UI["Original rich pages, calendar and pane<br/>Awaited reservation, room/configuration and catalog commands<br/>Unsupported writes unavailable"]
        API_STATE["Separate ApiProvider<br/>Canonical UUIDs, versions, captured minor-unit prices<br/>Loading/error states; drafts retained on failed save"]
        API_CLIENT["Typed API clients<br/>Paginated bootstrap and awaited POST/PATCH<br/>Expected version and request-key retry"]
        API_UI --> API_STATE
        API_STATE --> API_CLIENT
    end

    subgraph BACKEND["Isolated local backend - own Python virtual environment"]
        API["FastAPI via Uvicorn<br/>127.0.0.1:8001 when started"]
        LIVE["GET /api/v1/live<br/>Process liveness - no database access"]
        HEALTH["GET /api/v1/health<br/>Database readiness - SELECT 1<br/>200 healthy / 503 unavailable"]
        CONFIG["Pydantic settings and target guard<br/>Ignored local .env<br/>Only owned loopback database targets allowed"]
        ENGINE["SQLAlchemy + psycopg<br/>PostgreSQL connections in UTC"]
        ROUTES["Guest and reference APIs<br/>Reservation POST / list / detail<br/>Original PATCH: notes/counts only<br/>Explicit guest, stay, lifecycle, readiness and billing commands<br/>Versioned configuration/catalog endpoints"]
        COMMANDS["Reservations service<br/>Server-priced single-room direct bookings<br/>Version/row locks + request-key advisory lock<br/>Sorted room locks and PostgreSQL overlap exclusion<br/>One transaction: allocation, pricing, audit, receipt"]
        CONTEXT["Server-selected company<br/>Actor: local-development<br/>Business routes restricted to development environment"]
        subgraph MODEL["SQLAlchemy table definitions - schema only"]
            CORE["Core<br/>Companies and hotel time defaults<br/>Operational audit, mutation receipts"]
            RES["Reservations boundary<br/>Guests, rooms, room types, durations, rates,<br/>booking sources, reservations, allocations"]
            BILL["Billing boundary<br/>Append-only operational pricing revisions<br/>Server-captured purchases and signed adjustments<br/>No accounting journal or posting"]
        end
        CATALOG["Configuration boundary<br/>Owned versioned category/product definitions<br/>No stock movement ledger"]
        CATALOG --> ALEMBIC
        ROUTES --> CATALOG
        CATALOG --> ENGINE
        ALEMBIC["Alembic<br/>Seven frozen schema migrations<br/>Current head: 54e8c2a17d90<br/>Ownership, overlap, versions, reference metadata, room status and catalog"]
        SEED["Explicit development seed command<br/>Transactional, repeatable reference inserts<br/>Does not overwrite existing values"]
        TESTS["Opt-in PostgreSQL and HTTP tests<br/>Concurrency, rollback, server pricing and durable replay<br/>Real API restart verification in hms_test"]
        API --> LIVE
        API --> HEALTH
        API --> CONFIG
        HEALTH --> ENGINE
        API --> ROUTES
        ROUTES --> COMMANDS
        ROUTES --> CONTEXT
        COMMANDS --> ENGINE
        CONFIG --> ENGINE
        CORE --> ALEMBIC
        RES --> ALEMBIC
        BILL --> ALEMBIC
        CONFIG --> ALEMBIC
        SEED --> ENGINE
        TESTS --> ENGINE
    end

    subgraph DOCKER["Own Docker Compose project: hms-local-foundation"]
        PG["PostgreSQL 17.6<br/>Host 127.0.0.1:55432 → container 5432"]
        DEV[("hms_dev<br/>14 tables in hms schema<br/>Minimal explicit references + existing local records<br/>User business data preserved")]
        TESTDB[("hms_test<br/>Separate integration-test database<br/>Same migration history")]
        VOLUME[("Own persistent Docker volume<br/>hms-local-foundation_hms_pgdata")]
        PG --> DEV
        PG --> TESTDB
        PG --> VOLUME
    end

    ENGINE --> PG
    API_CLIENT --> API
    ALEMBIC --> PG

    EXCLUDED["Outside this architecture<br/>ZKBioTime: no shared Python, database or storage<br/>Supabase, native accounting and Odoo: not implemented"]

    classDef note fill:#fff7dd,stroke:#a87914,color:#332700;
    class GAP,EXCLUDED note;
