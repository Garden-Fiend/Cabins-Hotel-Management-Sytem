# Copy to .env and generate a private password; no defaults for secrets.
HMS_ENV=development
HMS_DB_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_SECRET
HMS_DATABASE_URL=postgresql+psycopg://hms_dev:REPLACE_WITH_RANDOM_LOCAL_SECRET@127.0.0.1:55432/hms_dev
HMS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional: only for explicitly opted-in integration tests, never a production database.
HMS_TEST_DATABASE_URL=postgresql+psycopg://hms_dev:REPLACE_WITH_RANDOM_LOCAL_SECRET@127.0.0.1:55432/hms_test
